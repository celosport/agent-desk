# Copie para .env e preencha ANTES de subir:  docker compose -f docker-compose.selfhost.yml up -d --build
# Nunca versione o .env.

# Senha do PostgreSQL deste compose (qualquer valor forte; só a API a enxerga)
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# Chave que assina os logins (JWT): 32 bytes ou mais, aleatória. Gere com:  openssl rand -base64 48
JWT_CHAVE_SECRETA=troque-por-uma-chave-aleatoria-de-pelo-menos-32-bytes

# Porta no seu computador
PORTA_HTTP=8080
